---
interface Props {
  label: string;
  href?: string;
  count?: number;
  active?: boolean;
}

const { label, href, count, active = false } = Astro.props;

const base =
  'inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 font-mono text-xs transition-colors';
const tone = active
  ? 'border-accent bg-accent-soft text-accent'
  : 'border-line text-muted hover:border-accent hover:text-accent';
---

{
  href ? (
    <a href={href} class={`${base} ${tone}`}>
      {label}
      {typeof count === 'number' && <span class="opacity-60">{count}</span>}
    </a>
  ) : (
    <span class={`${base} ${tone}`}>
      {label}
      {typeof count === 'number' && <span class="opacity-60">{count}</span>}
    </span>
  )
}

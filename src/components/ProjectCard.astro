---
import type { ProjectItem } from '../lib/projects';
import TagPill from './TagPill.astro';

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const isExternal = /^https?:\/\//.test(project.url);
---

<article
  class="group relative flex flex-col rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent/50"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-medium leading-snug">
      <a
        href={project.url}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
        class="transition-colors group-hover:text-accent"
      >
        {project.title}
        <span class="absolute inset-0" aria-hidden="true"></span>
      </a>
    </h3>

    <div class="flex shrink-0 items-center gap-2 font-mono text-xs text-muted">
      {
        project.pinned && (
          <span class="rounded border border-accent px-1.5 py-0.5 text-[0.68rem] text-accent">
            置顶
          </span>
        )
      }
      {
        typeof project.stars === 'number' && project.stars > 0 && (
          <span class="inline-flex items-center gap-1">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="m12 2 3.09 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 6.91-1.01L12 2Z" />
            </svg>
            {project.stars}
          </span>
        )
      }
    </div>
  </div>

  {project.description && <p class="mt-2 text-sm text-muted">{project.description}</p>}

  <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-4">
    {
      project.language && (
        <span class="font-mono text-xs text-muted">{project.language}</span>
      )
    }
    {project.tags.slice(0, 4).map((tag) => <TagPill label={tag} />)}
  </div>
</article>

---
import { NAV_LINKS, GITHUB, SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

function isActive(href: string, current: string) {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---

<header
  transition:persist="site-nav"
  data-pagefind-ignore
  class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 w-full max-w-3xl items-center justify-between gap-4 px-5 sm:px-8"
    aria-label="主导航"
  >
    <a href="/" class="group flex items-center gap-2 font-mono text-sm font-medium tracking-tight">
      <span
        class="inline-block h-2 w-2 rounded-full bg-accent transition-transform duration-300 group-hover:scale-150"
      ></span>
      <span>{SITE.title}</span>
    </a>

    <ul class="flex items-center gap-1 text-sm" data-nav-list>
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link={link.href}
              aria-current={isActive(link.href, path) ? 'page' : undefined}
              class="rounded-lg px-2.5 py-1.5 text-muted transition-colors hover:bg-surface-2 hover:text-text aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent aria-[current=page]:font-medium"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="ml-1">
        <a
          href="/search"
          data-nav-link="/search"
          aria-label="搜索"
          title="搜索（Ctrl K）"
          class="flex items-center rounded-lg p-2 text-muted transition-colors hover:bg-surface-2 hover:text-text"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </a>
      </li>
      <li class="hidden sm:block">
        <a
          href={GITHUB.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub 主页"
          class="flex items-center rounded-lg p-2 text-muted transition-colors hover:bg-surface-2 hover:text-text"
        >
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>
      </li>
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  // View Transitions 后同步导航高亮
  function syncNav() {
    var current = location.pathname;
    document.querySelectorAll('[data-nav-link]').forEach(function (a) {
      var href = a.getAttribute('data-nav-link');
      var active = href === '/' ? current === '/' : current === href || current.indexOf(href + '/') === 0;
      if (active) {
        a.setAttribute('aria-current', 'page');
      } else {
        a.removeAttribute('aria-current');
      }
    });
  }
  document.addEventListener('astro:page-load', syncNav);
  syncNav();
</script>

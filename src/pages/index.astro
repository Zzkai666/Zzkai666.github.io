---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero3DLoader from '../components/three/Hero3DLoader.tsx';
import HeroActions from '../components/motion/HeroActions.tsx';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getSortedPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';
import { SITE } from '../consts';

const posts = await getSortedPosts();
const latestPosts = posts.slice(0, 4);
const projects = getProjects().slice(0, 3);
---

<BaseLayout wide>
  <!-- data-scroll-story：GSAP 滚动叙事的根节点（见 src/lib/scroll-story.ts） -->
  <div data-scroll-story>
    <!-- ===== Hero：3D 场景（懒加载）+ 鼠标视差 ===== -->
    <section data-story="hero" class="relative -mx-5 overflow-hidden sm:-mx-8">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <Hero3DLoader client:only="react" />
      </div>

      <div
        class="relative mx-auto flex min-h-[66vh] max-w-3xl flex-col justify-center px-5 py-24 sm:px-8"
      >
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">personal site</p>

        <h1 class="mt-5 text-4xl font-semibold leading-[1.15] sm:text-5xl">
          你好，我是 {SITE.author}
        </h1>

        <p class="mt-5 max-w-xl text-lg text-muted">{SITE.tagline}</p>

        <!-- 行动按钮：React 岛，Motion 磁吸 + 弹性微交互 -->
        <HeroActions client:visible />

        <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4 font-mono text-xs text-muted">
          <div>
            <dt class="opacity-70">笔记</dt>
            <dd class="mt-1 text-2xl text-text">{posts.length}</dd>
          </div>
          <div>
            <dt class="opacity-70">项目</dt>
            <dd class="mt-1 text-2xl text-text">{projects.length}</dd>
          </div>
          <div>
            <dt class="opacity-70">状态</dt>
            <dd class="mt-1 text-2xl text-text">持续折腾中</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- ===== 最新笔记 ===== -->
    <section data-story="section" class="mx-auto mt-24 max-w-3xl px-5 sm:px-8">
      <div data-story-item class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">最新笔记</h2>
        <a href="/blog" class="font-mono text-xs text-muted transition-colors hover:text-accent">
          全部 {posts.length} 篇 →
        </a>
      </div>

      <div class="mt-6 grid gap-4">
        {
          latestPosts.map((post) => (
            <div data-story-item>
              <PostCard post={post} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- ===== 项目 ===== -->
    <section data-story="section" class="mx-auto mt-24 max-w-3xl px-5 sm:px-8">
      <div data-story-item class="flex items-baseline justify-between gap-4">
        <h2 class="text-xl font-semibold">项目</h2>
        <a href="/projects" class="font-mono text-xs text-muted transition-colors hover:text-accent">
          查看全部 →
        </a>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          projects.map((project) => (
            <div data-story-item>
              <ProjectCard project={project} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- ===== 好玩的东西 ===== -->
    <section data-story="section" class="mx-auto mt-24 max-w-3xl px-5 sm:px-8">
      <a
        data-story="playground"
        href="/playground"
        class="group block rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent/50"
      >
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">playground</p>
        <h2 class="mt-3 text-xl font-semibold transition-colors group-hover:text-accent">
          好玩的东西 →
        </h2>
        <p class="mt-2 max-w-lg text-sm text-muted">
          3D 场景、鼠标跟随、滚动动效……一些不一定有用、但挺有意思的实验。
        </p>
      </a>
    </section>
  </div>
</BaseLayout>

<script>
  import { initScrollStory } from '../lib/scroll-story';

  // View Transitions 每次切页后重新初始化，切走前由 scroll-story 内部负责 revert
  document.addEventListener('astro:page-load', initScrollStory);
  initScrollStory();
</script>

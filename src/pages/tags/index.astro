---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import { getSortedPosts, groupByTerm, termSlug } from '../../lib/posts';

const posts = await getSortedPosts();
const tags = groupByTerm(posts, 'tags');
---

<BaseLayout title="标签" description="按标签浏览 zzkai 的全部笔记。">
  <header>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">tags</p>
    <h1 class="mt-3 text-3xl font-semibold">标签</h1>
  </header>

  <div class="mt-8 flex flex-wrap gap-2">
    {
      tags.map((term) => (
        <TagPill
          label={term.name}
          count={term.count}
          href={`/tags/${termSlug(term.name)}/`}
        />
      ))
    }
  </div>

  {tags.length === 0 && <p class="mt-8 text-muted">还没有任何标签。</p>}
</BaseLayout>

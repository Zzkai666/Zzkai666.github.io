---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面不存在。">
  <div class="flex min-h-[50vh] flex-col justify-center">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">error</p>
    <h1 class="mt-4 font-mono text-6xl font-semibold">404</h1>
    <p class="mt-4 text-lg text-muted">这个页面不存在，或者已经被我删掉了。</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90"
      >
        回首页
      </a>
      <a
        href="/blog"
        class="rounded-lg border border-line px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
      >
        去看笔记
      </a>
    </div>
  </div>
</BaseLayout>

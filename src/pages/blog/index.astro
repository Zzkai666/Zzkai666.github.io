---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import TagPill from '../../components/TagPill.astro';
import { getSortedPosts, groupByTerm, termSlug } from '../../lib/posts';

const posts = await getSortedPosts();
const tags = groupByTerm(posts, 'tags');
const categories = groupByTerm(posts, 'categories');
---

<BaseLayout title="笔记" description="zzkai 的编程学习笔记：C++、数据结构、操作系统、图形化编程等。">
  <header>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">notes</p>
    <h1 class="mt-3 text-3xl font-semibold">笔记</h1>
    <p class="mt-3 text-muted">
      共 {posts.length} 篇，按时间倒序。都是学习过程中顺手整理的，不一定系统，但都是自己踩过的坑。
    </p>
  </header>

  {
    (tags.length > 0 || categories.length > 0) && (
      <div class="mt-8 space-y-3">
        {categories.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="mr-1 font-mono text-xs text-muted">分类</span>
            {categories.map((term) => (
              <TagPill
                label={term.name}
                count={term.count}
                href={`/categories/${termSlug(term.name)}/`}
              />
            ))}
          </div>
        )}
        {tags.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="mr-1 font-mono text-xs text-muted">标签</span>
            {tags.map((term) => (
              <TagPill
                label={`#${term.name}`}
                count={term.count}
                href={`/tags/${termSlug(term.name)}/`}
              />
            ))}
          </div>
        )}
      </div>
    )
  }

  <div class="mt-10 grid gap-4">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

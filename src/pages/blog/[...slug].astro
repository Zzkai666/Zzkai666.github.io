---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import { getSortedPosts, formatDate, readingTime, termSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      // 列表按时间倒序，因此 index+1 更旧、index-1 更新
      older: posts[index + 1] ?? null,
      newer: posts[index - 1] ?? null,
    },
  }));
}

const { post, older, newer } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;

const minutes = readingTime(post.body);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

<BaseLayout title={data.title} description={data.summary ?? data.title} wide>
  <!-- 阅读进度条 -->
  <div
    id="reading-progress"
    class="fixed left-0 top-16 z-30 h-0.5 w-0 bg-accent transition-[width] duration-75"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-5xl">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_210px] lg:gap-12">
      <div class="min-w-0">
        <a
          href="/blog"
          class="font-mono text-xs text-muted transition-colors hover:text-accent"
        >
          ← 返回笔记列表
        </a>

        <header class="mt-6 border-b border-line pb-6">
          <h1 class="text-3xl font-semibold leading-tight">{data.title}</h1>

          <div class="mt-4 flex flex-wrap items-center gap-3 font-mono text-xs text-muted">
            <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} 分钟</span>
            {
              data.updated && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>更新于 {formatDate(data.updated)}</span>
                </>
              )
            }
          </div>

          {
            (data.tags.length > 0 || data.categories.length > 0) && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {data.categories.map((c) => (
                  <TagPill label={c} href={`/categories/${termSlug(c)}/`} />
                ))}
                {data.tags.map((t) => (
                  <TagPill label={`#${t}`} href={`/tags/${termSlug(t)}/`} />
                ))}
              </div>
            )
          }
        </header>

        {/* 移动端的目录 */}
        {
          toc.length > 1 && (
            <details class="mt-6 rounded-xl border border-line bg-surface p-4 lg:hidden">
              <summary class="cursor-pointer font-mono text-xs text-muted">目录</summary>
              <ol class="mt-3 space-y-1.5 text-sm">
                {toc.map((heading) => (
                  <li class={heading.depth === 3 ? 'pl-4' : ''}>
                    <a href={`#${heading.slug}`} class="text-muted hover:text-accent">
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          )
        }

        <!-- data-pagefind-body：只把正文纳入搜索索引，导航/目录/上下篇不参与 -->
        <article class="article mt-8" data-pagefind-body>
          <Content />
        </article>

        <nav class="mt-14 grid gap-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="上下篇">
          {
            older ? (
              <a
                href={`/blog/${older.id}/`}
                class="rounded-xl border border-line bg-surface p-4 transition-colors hover:border-accent/50"
              >
                <span class="font-mono text-xs text-muted">← 更早</span>
                <p class="mt-1 text-sm font-medium">{older.data.title}</p>
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a
                href={`/blog/${newer.id}/`}
                class="rounded-xl border border-line bg-surface p-4 text-right transition-colors hover:border-accent/50 sm:col-start-2"
              >
                <span class="font-mono text-xs text-muted">更新 →</span>
                <p class="mt-1 text-sm font-medium">{newer.data.title}</p>
              </a>
            )
          }
        </nav>
      </div>

      {/* 桌面端目录 */}
      {
        toc.length > 1 && (
          <aside class="hidden lg:block">
            <div class="sticky top-24">
              <p class="font-mono text-xs uppercase tracking-wider text-muted">目录</p>
              <ol class="mt-4 space-y-2 border-l border-line text-sm">
                {toc.map((heading) => (
                  <li class={heading.depth === 3 ? 'pl-5' : 'pl-3'}>
                    <a
                      href={`#${heading.slug}`}
                      class="-ml-px block border-l border-transparent pl-2 text-muted transition-colors hover:border-accent hover:text-accent"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function initReadingProgress() {
    var bar = document.getElementById('reading-progress');
    if (!bar) return;

    var update = function () {
      var doc = document.documentElement;
      var total = doc.scrollHeight - window.innerHeight;
      var ratio = total > 0 ? Math.min(1, window.scrollY / total) : 0;
      bar.style.width = (ratio * 100).toFixed(2) + '%';
    };

    window.removeEventListener('scroll', window.__zzkaiProgress);
    window.__zzkaiProgress = update;
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  document.addEventListener('astro:page-load', initReadingProgress);
  initReadingProgress();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts, termSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const names = new Set<string>();
  for (const post of posts) {
    for (const category of post.data.categories) names.add(category);
  }

  return [...names].map((category) => ({
    // params 用 slug（与 tags 页同一套规则，见 lib/posts.ts 的 termSlug）
    params: { category: termSlug(category) },
    props: {
      category,
      posts: posts.filter((post) => post.data.categories.includes(category)),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={category} description={`分类「${category}」下的全部笔记。`}>
  <a href="/categories" class="font-mono text-xs text-muted transition-colors hover:text-accent">
    ← 全部分类
  </a>

  <header class="mt-6">
    <h1 class="text-3xl font-semibold">{category}</h1>
    <p class="mt-2 font-mono text-xs text-muted">{posts.length} 篇</p>
  </header>

  <div class="mt-10 grid gap-4">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

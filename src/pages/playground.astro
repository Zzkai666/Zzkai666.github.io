---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="好玩的东西"
  description="3D 场景、鼠标跟随、滚动动效等实验性交互作品。"
  wide
>
  <div class="mx-auto max-w-5xl">
    <header>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">playground</p>
      <h1 class="mt-3 text-3xl font-semibold">好玩的东西</h1>
      <p class="mt-3 max-w-2xl text-muted">
        一些不一定有用、但挺有意思的实验。首页那个可交互的 3D 场景也是其中之一，
        这里放的是更小的、可以单独玩的片段。
      </p>
    </header>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <!-- 1. 光标聚光 -->
      <section
        data-spotlight
        class="relative overflow-hidden rounded-xl border border-line bg-surface p-6"
      >
        <p class="font-mono text-xs text-accent">01 · cursor spotlight</p>
        <h2 class="mt-3 text-lg font-semibold">光标聚光</h2>
        <p class="mt-2 text-sm text-muted">
          光斑跟随鼠标移动。纯 CSS 变量驱动，没有引入任何动画库。
        </p>
        <div
          class="mt-6 h-28 rounded-lg border border-line bg-bg"
          style="background-image: radial-gradient(180px circle at var(--sx, 50%) var(--sy, 50%), var(--accent-soft), transparent 70%);"
        >
        </div>
      </section>

      <!-- 2. 3D 倾斜卡片 -->
      <section class="rounded-xl border border-line bg-surface p-6" style="perspective: 900px;">
        <p class="font-mono text-xs text-accent">02 · tilt card</p>
        <h2 class="mt-3 text-lg font-semibold">3D 倾斜卡片</h2>
        <p class="mt-2 text-sm text-muted">把鼠标移到卡片上，它会朝你倾斜。</p>
        <div
          data-tilt
          class="mt-6 flex h-28 items-center justify-center rounded-lg border border-accent bg-accent-soft font-mono text-sm text-accent transition-transform duration-150"
          style="transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transform-style: preserve-3d;"
        >
          hover me
        </div>
      </section>

      <!-- 3. 打字机 -->
      <section class="rounded-xl border border-line bg-surface p-6">
        <p class="font-mono text-xs text-accent">03 · typewriter</p>
        <h2 class="mt-3 text-lg font-semibold">打字机</h2>
        <p class="mt-2 text-sm text-muted">循环播放的逐字输入效果。</p>
        <p class="mt-6 h-28 font-mono text-sm leading-relaxed">
          <span
            data-typewriter={JSON.stringify([
              'console.log("hello, world")',
              'git push origin main',
              'npm run build && deploy',
              'while (alive) { learn(); }',
            ])}
            class="text-accent"></span>
          <span class="typewriter-caret text-accent" aria-hidden="true">▌</span>
        </p>
        <noscript>
          <p class="text-sm text-muted">开启 JavaScript 后可以看到打字效果。</p>
        </noscript>
      </section>

      <!-- 4. 滚动入场 -->
      <section class="rounded-xl border border-line bg-surface p-6">
        <p class="font-mono text-xs text-accent">04 · scroll reveal</p>
        <h2 class="mt-3 text-lg font-semibold">滚动入场</h2>
        <p class="mt-2 text-sm text-muted">
          基于 CSS <code class="font-mono text-xs">animation-timeline: view()</code>
          的原生滚动动画，零 JavaScript。往下滚动试试。
        </p>
        <div class="mt-6 space-y-2">
          {[0, 1, 2].map((i) => (
            <div
              class="reveal h-8 rounded-lg border border-line bg-bg px-3 font-mono text-xs leading-8 text-muted"
              style={`animation-delay: ${i * 80}ms`}
            >
              区块 {i + 1}
            </div>
          ))}
        </div>
      </section>
    </div>

    <p class="mt-10 text-sm text-muted">
      想加新的实验？在 <code class="font-mono text-xs">src/pages/playground.astro</code>
      里加一个 section 就行。
    </p>
  </div>
</BaseLayout>

<style>
  .typewriter-caret {
    animation: caret-blink 1s steps(2, start) infinite;
  }

  @keyframes caret-blink {
    to {
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-caret {
      animation: none;
    }
  }
</style>

<script is:inline>
  function initPlayground() {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. 光标聚光
    document.querySelectorAll('[data-spotlight]').forEach(function (el) {
      if (el.dataset.bound) return;
      el.dataset.bound = '1';
      el.addEventListener('mousemove', function (event) {
        var rect = el.getBoundingClientRect();
        el.style.setProperty('--sx', ((event.clientX - rect.left) / rect.width) * 100 + '%');
        el.style.setProperty('--sy', ((event.clientY - rect.top) / rect.height) * 100 + '%');
      });
    });

    // 2. 3D 倾斜
    if (!reduceMotion) {
      document.querySelectorAll('[data-tilt]').forEach(function (el) {
        if (el.dataset.bound) return;
        el.dataset.bound = '1';
        var strength = 12;
        el.addEventListener('mousemove', function (event) {
          var rect = el.getBoundingClientRect();
          var px = (event.clientX - rect.left) / rect.width - 0.5;
          var py = (event.clientY - rect.top) / rect.height - 0.5;
          el.style.setProperty('--rx', (-py * strength).toFixed(2) + 'deg');
          el.style.setProperty('--ry', (px * strength).toFixed(2) + 'deg');
        });
        el.addEventListener('mouseleave', function () {
          el.style.setProperty('--rx', '0deg');
          el.style.setProperty('--ry', '0deg');
        });
      });
    }

    // 3. 打字机
    if (!reduceMotion) {
      document.querySelectorAll('[data-typewriter]').forEach(function (el) {
        if (el.dataset.bound) return;
        el.dataset.bound = '1';

        var phrases;
        try {
          phrases = JSON.parse(el.getAttribute('data-typewriter'));
        } catch (e) {
          return;
        }
        if (!phrases || !phrases.length) return;

        var index = 0;
        var cursor = 0;
        var deleting = false;

        (function tick() {
          var current = phrases[index];
          cursor += deleting ? -1 : 1;
          el.textContent = current.slice(0, cursor);

          var delay = deleting ? 40 : 85;
          if (!deleting && cursor === current.length) {
            delay = 1600;
            deleting = true;
          } else if (deleting && cursor === 0) {
            deleting = false;
            index = (index + 1) % phrases.length;
            delay = 320;
          }

          window.setTimeout(tick, delay);
        })();
      });
    }
  }

  document.addEventListener('astro:page-load', initPlayground);
  initPlayground();
</script>

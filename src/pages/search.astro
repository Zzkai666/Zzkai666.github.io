---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="在全部笔记中按关键词检索。">
  <header>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">search</p>
    <h1 class="mt-3 text-3xl font-semibold">搜索</h1>
    <p class="mt-3 text-muted">在全部笔记中按关键词查找。索引由 Pagefind 在构建时生成。</p>
  </header>

  <div class="mt-8">
    <label for="search-input" class="sr-only">搜索关键词</label>
    <div class="relative">
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="输入关键词…"
        class="w-full rounded-lg border border-line bg-surface px-4 py-3 pr-16 text-sm outline-none transition-colors placeholder:text-muted focus:border-accent"
      />
      <kbd
        class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded border border-line px-1.5 py-0.5 font-mono text-[0.68rem] text-muted sm:block"
      >
        Ctrl K
      </kbd>
    </div>

    <p
      id="search-status"
      class="mt-3 font-mono text-xs text-muted"
      role="status"
      aria-live="polite"
      data-pagefind-ignore
    >
    </p>
  </div>

  <div id="search-results" class="mt-8 grid gap-4" data-pagefind-ignore></div>
</BaseLayout>

<script>
  const INDEX_URL = '/pagefind/pagefind.js';

  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta?: { title?: string };
    sub_results?: { title: string; url: string; excerpt: string }[];
  }

  interface PagefindModule {
    init: () => Promise<void>;
    search: (query: string) => Promise<{ results: { data: () => Promise<PagefindResultData> }[] }>;
  }

  let module: PagefindModule | null = null;
  let loading: Promise<PagefindModule | null> | null = null;

  /** 懒加载索引：只有真正搜索时才去取 pagefind.js */
  function loadPagefind(): Promise<PagefindModule | null> {
    if (module) return Promise.resolve(module);
    if (loading) return loading;

    loading = import(/* @vite-ignore */ INDEX_URL)
      .then(async (mod: PagefindModule) => {
        await mod.init();
        module = mod;
        return mod;
      })
      .catch(() => null);

    return loading;
  }

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderResults(items: PagefindResultData[], query: string) {
    const host = document.getElementById('search-results');
    if (!host) return;

    if (items.length === 0) {
      host.innerHTML = `<p class="rounded-xl border border-dashed border-line p-5 text-sm text-muted">没有找到包含「${escapeHtml(
        query
      )}」的笔记。</p>`;
      return;
    }

    host.innerHTML = items
      .map((item) => {
        const title = escapeHtml(item.meta?.title ?? item.url);
        return `
          <article class="rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent/50">
            <h2 class="text-base font-medium">
              <a href="${escapeHtml(item.url)}" class="transition-colors hover:text-accent">${title}</a>
            </h2>
            <p class="mt-2 text-sm text-muted [&_mark]:rounded [&_mark]:bg-accent-soft [&_mark]:px-0.5 [&_mark]:text-accent">${item.excerpt}</p>
          </article>
        `;
      })
      .join('');
  }

  async function runSearch(query: string) {
    const status = document.getElementById('search-status');
    const trimmed = query.trim();

    if (!status) return;

    if (trimmed.length === 0) {
      status.textContent = '';
      const host = document.getElementById('search-results');
      if (host) host.innerHTML = '';
      return;
    }

    status.textContent = '搜索中…';

    const pf = await loadPagefind();
    if (!pf) {
      status.textContent =
        '搜索索引还没生成。本地开发需要先执行 npm run build 再执行 npm run search:index；线上由 CI 自动完成。';
      return;
    }

    const search = await pf.search(trimmed);
    const items = await Promise.all(search.results.slice(0, 12).map((result) => result.data()));

    status.textContent = `找到 ${search.results.length} 条结果，显示前 ${items.length} 条。`;
    renderResults(items, trimmed);
  }

  function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    if (!input || input.dataset.bound === '1') return;
    input.dataset.bound = '1';

    let timer: number | undefined;

    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => runSearch(input.value), 220);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        window.clearTimeout(timer);
        runSearch(input.value);
      }
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        input.focus();
      }
    });

    // 支持 /search?q=xxx 直接带参进入
    const preset = new URLSearchParams(location.search).get('q');
    if (preset) {
      input.value = preset;
      runSearch(preset);
    }
  }

  document.addEventListener('astro:page-load', initSearch);
  initSearch();
</script>

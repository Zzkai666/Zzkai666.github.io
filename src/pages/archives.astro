---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedPosts, formatDate, groupByYear } from '../lib/posts';

const posts = await getSortedPosts();
const years = groupByYear(posts);
---

<BaseLayout title="归档" description="按年份归档的全部笔记。">
  <header>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">archive</p>
    <h1 class="mt-3 text-3xl font-semibold">归档</h1>
    <p class="mt-3 text-muted">共 {posts.length} 篇，跨越 {years.length} 个年份。</p>
  </header>

  <div class="mt-12 space-y-12">
    {
      years.map((bucket) => (
        <section>
          <div class="flex items-center gap-4">
            <h2 class="font-mono text-2xl font-semibold text-accent">{bucket.year}</h2>
            <span class="h-px flex-1 bg-line" />
            <span class="font-mono text-xs text-muted">{bucket.posts.length} 篇</span>
          </div>

          <ol class="reveal mt-6 space-y-4 border-l border-line pl-6">
            {bucket.posts.map((post) => (
              <li class="relative">
                <span
                  class="absolute -left-[1.65rem] top-2.5 h-2 w-2 rounded-full border border-accent bg-bg"
                  aria-hidden="true"
                />
                <time class="font-mono text-xs text-muted" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <a
                  href={`/blog/${post.id}/`}
                  class="mt-1 block font-medium transition-colors hover:text-accent"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  {posts.length === 0 && <p class="mt-8 text-muted">还没有任何笔记。</p>}
</BaseLayout>
